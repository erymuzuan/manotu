    },
    "Guests navigate to the vehicle entrance when there is one, else to the pin. Only the coordinates are sent for routing." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu dipandu ke pintu masuk kenderaan jika ada, jika tidak ke pin. Hanya koordinat dihantar untuk mencari laluan."
          }
        }
      }
    },
    "Guests see" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu nampak"
          }
        }
      }
    },
    "Guests see the places, times and route distances, but not the route lines." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu nampak tempat, masa dan jarak laluan, tetapi bukan garis laluan."
          }
        }
      }
    },
    "Guests see the places, times and route distances, but not the route lines. Send the event file too for those who want the full route." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu nampak tempat, masa dan jarak laluan, tetapi bukan garisan laluan. Hantar juga fail acara untuk sesiapa yang mahukan laluan penuh."
          }
        }
      }
    },
    "Guests who haven't opened it yet can't any more. Guests who already have the event keep it, but won't get updates. Sharing again makes a new link." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu yang belum membukanya tidak dapat membukanya lagi. Tetamu yang sudah ada acara ini masih menyimpannya, tetapi tidak menerima kemas kini. Kongsi semula untuk membuat pautan baharu."
          }
        }
      }
    },
    "Guests will receive" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu akan terima"
          }
        }
      }
    },
    "Guests will see the name you give the place in the event, not your saved label." : {
      "localizations" : {
        "ms" : {
