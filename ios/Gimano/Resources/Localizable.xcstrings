    "“%@” has new details" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ada butiran baharu"
          }
        }
      }
    },
    "“%@” isn't a recovery-code word." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan perkataan kod pemulihan."
          }
        }
      }
    },
    "“%@” moved %@" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” dialihkan %2$@"
          }
        }
      }
    },
    "“For whom” is too long (40 characters at most)." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Untuk siapa” terlalu panjang (maksimum 40 aksara)."
          }
        }
      }
    },
    "“Keep” leaves the plan on this phone as it is. You can open the new invitation again later." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kekal” mengekalkan pelan di telefon ini. Anda boleh buka jemputan baharu kemudian."
          }
        }
      }
    },
    "“Navigate” takes you to a stop. Following the route turn by turn isn't available yet." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pandu” membawa anda ke hentian. Navigasi mengikut laluan belum tersedia."
          }
        }
      }
    },
    "“Save” stays on your phone only. “Add a place” asks whether it's just for you, or shared and confirmed by people nearby." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Simpan” kekal dalam telefon anda sahaja. “Tambah tempat” bertanya sama ada untuk anda sahaja, atau dikongsi dan disahkan oleh orang berdekatan."
          }
        }
      }
    },
    "“Share invitation” sends the event file instead. Guests open it in Manotu." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kongsi jemputan” akan menghantar fail acara. Tetamu membukanya dalam Manotu."
          }
        }
      }
    }
  },
  "version" : "1.0"
