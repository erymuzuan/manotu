    "Drive smarter with reports from drivers around you. Gimano needs your location to show where you are and guide you turn by turn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive smarter with reports from drivers around you. Manotu needs your location to show where you are and guide you turn by turn."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memandu lebih bijak dengan laporan daripada pemandu di sekeliling anda. Manotu memerlukan lokasi anda untuk menunjukkan kedudukan anda dan memandu arah demi arah."
          }
        }
      }
    },
