      }
    },
    "You blocked the person who added this place" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda menyekat orang yang menambah tempat ini"
          }
        }
      }
    },
    "You can block any contributor: their reviews and photos disappear from your phone." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menyekat mana-mana penyumbang: ulasan dan foto mereka hilang dari telefon anda."
          }
        }
      }
    },
    "You can block any user: their reviews and photos are hidden on your phone." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menyekat mana-mana pengguna: ulasan dan gambar mereka disembunyikan dalam telefon anda."
          }
        }
      }
    },
    "You can still look at the map, find places and compare routes. Turn-by-turn directions start only after you agree to the safety agreement." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda masih boleh melihat peta, mencari tempat dan membandingkan laluan. Arahan pandu dimulakan hanya selepas anda bersetuju dengan perjanjian keselamatan."
          }
        }
      }
    },
    "You can turn it on again in Settings." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menghidupkannya semula dalam Tetapan."
          }
        }
      }
    },
    "You have arrived" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah tiba"
          }
        }
      }
    },
    "You have arrived at %@" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah tiba di %@"
          }
        }
      }
    },
    "You haven't blocked anyone." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda belum menyekat sesiapa."
          }
        }
      }
    },
    "You keep this copy until its access ends, but updates from the organizer no longer arrive." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan ini kekal sehingga akses tamat, tetapi kemas kini daripada penganjur tidak lagi diterima."
          }
        }
      }
    },
    "You organize this event, so nothing is imported. Open it to edit or share." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda penganjur acara ini, jadi tiada apa yang diimport. Bukanya untuk ubah atau kongsi."
          }
        }
      }
    },
    "You start on Jalan Sultan Ismail, Kuala Lumpur, and drives are simulated" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bermula di Jalan Sultan Ismail, Kuala Lumpur, dan pemanduan disimulasikan"
          }
        }
      }
    },
    "You're already here" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah di sini"
          }
        }
      }
    },
    "You're on your way to the old location of “%@”. Your destination won't change unless you agree." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang menuju ke lokasi lama “%@”. Destinasi tidak akan ditukar tanpa persetujuan anda."
          }
        }
      }
    },
    "You're on your way to “%@”, which is no longer in the plan. Your destination won't change unless you agree." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang menuju ke “%@”, yang tiada lagi dalam pelan. Destinasi tidak akan ditukar tanpa persetujuan anda."
          }
        }
      }
    },
    "You've arrived" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah tiba"
          }
        }
      }
    },
    "Your Manotu account was deleted" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun Manotu anda telah dipadam"
          }
        }
      }
    },
    "Your account can't post right now: it was suspended for breaking the community rules." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun anda tidak boleh menghantar sekarang: ia digantung kerana melanggar peraturan komuniti."
          }
        }
      }
    },
    "Your location" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi anda"
          }
        }
      }
    },
    "Your location unknown" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi anda tidak diketahui"
          }
        }
      }
    },
    "Your own iCloud account" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun iCloud anda sendiri"
          }
        }
      }
    },
    "Your places stay on your phone" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat anda kekal dalam telefon ini"
          }
        }
      }
    },
    "Your places stay on your phone. Backups go straight to your own storage; Gimano can't read them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your places stay on your phone. Backups go straight to your own storage; Manotu can't read them."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat anda kekal dalam telefon. Sandaran pergi terus ke storan anda sendiri; Manotu tidak dapat membacanya."
          }
        }
      }
    },
    "Your position, on the phone. Sent only as anonymous pings while navigating." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedudukan anda, dalam telefon. Dihantar hanya sebagai isyarat tanpa nama semasa navigasi."
          }
        }
      }
    },
    "Your pseudonym" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama samaran anda"
          }
        }
      }
    },
    "Your routes stay on this phone and in your own backup. Routing sends only coordinates and travel mode, and nothing is stored on the server." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laluan anda kekal di telefon ini dan dalam sandaran anda sendiri. Pengiraan laluan hanya menghantar koordinat dan mod perjalanan, dan tiada apa disimpan di pelayan."
          }
        }
      }
    },
    "Your safety code. Guests can check it." : {
      "localizations" : {
        "ms" : {
