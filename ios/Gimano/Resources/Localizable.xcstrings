    "Add the start first, then the stops and the finish. Manotu follows the roads between them." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah tempat mula dahulu, kemudian hentian dan tamat. Manotu ikut jalan di antaranya."
          }
        }
      }
    },
    "Add to favourites" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah ke kegemaran"
          }
        }
      }
    },
    "Added by a Gimano user" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added by a Manotu user"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditambah oleh pengguna Manotu"
          }
        }
      }
    },
    "After 10 s on the route preview, for Home, Work, favourites, recent places and planned drives. Never after a search." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas 10 s pada pratonton laluan, untuk Rumah, Kerja, kegemaran, tempat terkini dan perjalanan dirancang. Tidak selepas carian."
          }
        }
      }
    },
    "After access ends, Manotu deletes the event from phones. Copies outside Manotu may still exist." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
