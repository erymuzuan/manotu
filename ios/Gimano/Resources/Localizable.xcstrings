        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disulitkan hujung ke hujung. Manotu tidak pernah menyimpan frasa laluan anda: jika hilang, sandaran ini tidak dapat dipulihkan."
          }
        }
