    "Home" : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah"
          }
        }
      }
    },
    "Home, work, kampung, your in-laws' house: your places live on your phone, not on our servers. Gimano never stores your personal data. Backups go straight to your own Google Drive or iCloud, optionally locked with a passphrase only you know." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home, work, kampung, your in-laws' house: your places live on your phone, not on our servers. Manotu never stores your personal data. Backups go straight to your own Google Drive or iCloud, optionally locked with a passphrase only you know."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, tempat kerja, kampung, rumah mertua: semua tempat kegemaran anda disimpan dalam telefon anda sahaja. Manotu tidak menyimpan data peribadi anda di pelayan kami. Sandaran pergi terus ke Google Drive atau iCloud anda sendiri, dan boleh dikunci dengan frasa laluan yang hanya anda tahu."
          }
        }
      }
    },
    "Home, work, kampung, your in-laws' house: your places live on your phone, not on our servers. Manotu never stores your personal data. Back up to a file you keep, optionally locked with a passphrase only you know." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, tempat kerja, kampung, rumah mertua: semua tempat kegemaran anda disimpan dalam telefon anda sahaja. Manotu tidak menyimpan data peribadi anda di pelayan kami. Sandarkan ke fail yang anda simpan sendiri, dan boleh dikunci dengan frasa laluan yang hanya anda tahu."
          }
        }
      }
    },
    "Home, work, kampung, your in-laws' house: your places live on your phone, not on our servers. Manotu never stores your personal data. Backups go straight to your own Google Drive or a file, optionally locked with a passphrase only you know." : {
      "localizations" : {
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumah, tempat kerja, kampung, rumah mertua: semua tempat kegemaran anda disimpan dalam telefon anda sahaja. Manotu tidak menyimpan data peribadi anda di pelayan kami. Sandaran pergi terus ke Google Drive anda sendiri atau ke fail, dan boleh dikunci dengan frasa laluan yang hanya anda tahu."
          }
        }
      }
    },
