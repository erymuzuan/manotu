# App Store Connect API key for TestFlight uploads. Copy to Config/asc.env (git-ignored) and fill in.
# Create the key at App Store Connect → Users and Access → Integrations → App Store Connect API (role: App Manager).
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_ID=ABCDE12345
# Absolute path to the downloaded AuthKey_<KEY_ID>.p8 (keep it outside the repo, or in ios/Config/ which ignores *.p8).
ASC_KEY_PATH=/Users/you/keys/AuthKey_ABCDE12345.p8
# Approved store team: STAFY COMPANY LIMITED (owner reconfirmed 26 Oct 2026, see AGENTS.md).
ASC_TEAM_ID=98KY9PMPX3
