// Code signing and app identity for Manotu (formerly Gimano). Committed; contains no personal values.
// Put your own Apple Developer Team ID in Config/Local.xcconfig (git-ignored):
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
DEVELOPMENT_TEAM =

// Build variant: manotu (default, bundle id my.manotu.app) or gimano (legacy my.gimano.app).
// Override in Local.xcconfig (APP_VARIANT = gimano) or on the xcodebuild command line.
APP_VARIANT = manotu
APP_BUNDLE_ID_manotu = my.manotu.app
APP_BUNDLE_ID_gimano = my.gimano.app

// iCloud backup (CloudKit container iCloud.<bundle id>). Needs the iCloud capability on the App ID; set
// GIMANO_ICLOUD = NO to build without the iCloud entitlement (the app then shows "iCloud isn't enabled in this build").
GIMANO_ICLOUD = YES

// Universal Links for event invitations (https://manotu.app/j/#… and /a/#…, docs/events.md §5.6): the Associated
// Domains entitlement `applinks:manotu.app`. It needs the "Associated Domains" capability on the App ID in the developer
// portal (and the provisioning profile regenerated), so it is off by default: builds signed with today's profiles keep
// working, and links still open the app through the web page's "Buka di Manotu" (manotu://). Set MANOTU_APPLINKS = YES
// once the capability is enabled.
MANOTU_APPLINKS = NO

// CODE_SIGN_ENTITLEMENTS (project.yml) = $(GIMANO_ENTITLEMENTS_$(GIMANO_ICLOUD)), resolved here for MANOTU_APPLINKS too.
GIMANO_ENTITLEMENTS_YES = $(GIMANO_ENTITLEMENTS_CLOUD_$(MANOTU_APPLINKS))
GIMANO_ENTITLEMENTS_NO = $(GIMANO_ENTITLEMENTS_NOCLOUD_$(MANOTU_APPLINKS))
GIMANO_ENTITLEMENTS_CLOUD_NO = Gimano/Resources/Gimano.entitlements
GIMANO_ENTITLEMENTS_CLOUD_YES = Gimano/Resources/Gimano-AppLinks.entitlements
GIMANO_ENTITLEMENTS_NOCLOUD_NO = Gimano/Resources/Gimano-NoCloud.entitlements
GIMANO_ENTITLEMENTS_NOCLOUD_YES = Gimano/Resources/Gimano-NoCloud-AppLinks.entitlements

// CarPlay (docs/driving.md §5): the CarPlay navigation entitlement (com.apple.developer.carplay-maps) is not granted
// yet, so only simulator builds carry it (the iOS Simulator's CarPlay display). Device, TestFlight and AltStore builds
// keep the entitlements above and sign with today's profiles; the CarPlay scene is simply never connected there.
// Once Apple grants it to the individual team, add the key to the four files above and drop these overrides.
GIMANO_ENTITLEMENTS_CLOUD_NO[sdk=iphonesimulator*] = Gimano/Resources/CarPlaySim/Gimano.entitlements
GIMANO_ENTITLEMENTS_CLOUD_YES[sdk=iphonesimulator*] = Gimano/Resources/CarPlaySim/Gimano-AppLinks.entitlements
GIMANO_ENTITLEMENTS_NOCLOUD_NO[sdk=iphonesimulator*] = Gimano/Resources/CarPlaySim/Gimano-NoCloud.entitlements
GIMANO_ENTITLEMENTS_NOCLOUD_YES[sdk=iphonesimulator*] = Gimano/Resources/CarPlaySim/Gimano-NoCloud-AppLinks.entitlements

// Google Drive backup (GoogleSignIn + Drive appDataFolder). The store/TestFlight build sets GIMANO_DRIVE = NO
// (owner decision 2026-10-24): no Drive destination, no Google sign-in, no Drive auto-backup or restore, and no Google
// client id or URL scheme in Info.plist. Every user of that build sees the same thing. Dev and sideload builds keep YES.
GIMANO_DRIVE = YES

// Google Drive backup OAuth clients (git-ignored values): cp Config/Google.xcconfig.example Config/Google.xcconfig
MANOTU_GOOGLE_CLIENT_ID =
MANOTU_GOOGLE_REVERSED_CLIENT_ID = manotu-google-not-configured
GIMANO_GOOGLE_CLIENT_ID =
GIMANO_GOOGLE_REVERSED_CLIENT_ID = gimano-google-not-configured

#include? "Local.xcconfig"
#include? "Google.xcconfig"

// Resolved for the active variant (used by project.yml, Info.plist and the entitlements).
APP_BUNDLE_ID = $(APP_BUNDLE_ID_$(APP_VARIANT))
APP_ICLOUD_CONTAINER = iCloud.$(APP_BUNDLE_ID)
APP_GOOGLE_CLIENT_ID_manotu = $(MANOTU_GOOGLE_CLIENT_ID)
APP_GOOGLE_CLIENT_ID_gimano = $(GIMANO_GOOGLE_CLIENT_ID)
APP_GOOGLE_REVERSED_CLIENT_ID_manotu = $(MANOTU_GOOGLE_REVERSED_CLIENT_ID)
APP_GOOGLE_REVERSED_CLIENT_ID_gimano = $(GIMANO_GOOGLE_REVERSED_CLIENT_ID)
APP_GOOGLE_CLIENT_ID_DRIVE_YES = $(APP_GOOGLE_CLIENT_ID_$(APP_VARIANT))
APP_GOOGLE_CLIENT_ID_DRIVE_NO =
APP_GOOGLE_REVERSED_CLIENT_ID_DRIVE_YES = $(APP_GOOGLE_REVERSED_CLIENT_ID_$(APP_VARIANT))
APP_GOOGLE_REVERSED_CLIENT_ID_DRIVE_NO = manotu-google-drive-disabled
// With GIMANO_DRIVE = NO the Info.plist gets an empty GIDClientID and a placeholder URL scheme, never the real client.
APP_GOOGLE_CLIENT_ID = $(APP_GOOGLE_CLIENT_ID_DRIVE_$(GIMANO_DRIVE))
APP_GOOGLE_REVERSED_CLIENT_ID = $(APP_GOOGLE_REVERSED_CLIENT_ID_DRIVE_$(GIMANO_DRIVE))
