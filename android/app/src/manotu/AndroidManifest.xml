<?xml version="1.0" encoding="utf-8"?>
<!-- Manotu flavor only (my.manotu.app): opening event invitations (docs/events.md §5). The farewell my.gimano.app
     builds don't register these, so a phone with both installed never shows a chooser. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="manotu" android:host="place" />
            </intent-filter>
            <!-- Navigate link from other apps (docs/place-links.md): always asks the user before routing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="manotu" android:host="navigate" />
            </intent-filter>
            <!-- Web viewer hand-off (§5.3): manotu://event#1.<key>.<data>, manotu://event?stop=<id>#…; short links (§5.6)
                 manotu://event?drop=<dropId>#<secret>; gimano:// accepted too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="manotu" android:host="event" />
                <data android:scheme="gimano" android:host="event" />
            </intent-filter>
            <!-- Legacy invitation links (§5.1) on bukitbunga.com. No autoVerify: assetlinks.json can't be published at
                 that site's root, so on Android 12+ the user enables them under App info → Open by default → Add link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bukitbunga.com" android:path="/gimano/a/" />
                <data android:scheme="https" android:host="www.bukitbunga.com" android:path="/gimano/a" />
            </intent-filter>
            <!-- Android App Links on manotu.app (§5.1 /a/, §5.6 short links /j/): verified against
                 https://manotu.app/.well-known/assetlinks.json. Only the apex host here, so www (which redirects) can't
                 fail the verification; www keeps the unverified filter below. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="manotu.app" />
                <data android:path="/nav/" />
                <data android:path="/nav" />
                <data android:path="/p/" />
                <data android:path="/p" />
                <data android:path="/a/" />
                <data android:path="/a" />
                <data android:path="/j/" />
                <data android:path="/j" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.manotu.app" />
                <data android:path="/a/" />
                <data android:path="/a" />
                <data android:path="/j/" />
                <data android:path="/j" />
            </intent-filter>
            <!-- "Open with" a .manotu-event file (§5.2); the app checks the MNTE header before asking for the code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.manotu.event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.manotu-event" />
                <data android:pathPattern=".*\\..*\\.manotu-event" />
                <data android:pathPattern=".*\\..*\\..*\\.manotu-event" />
            </intent-filter>
            <!-- WhatsApp and others hand documents over as application/octet-stream content:// URIs with no file name
                 in the path, so accept any octet-stream; MainActivity reads at most 20 MiB and checks "MNTE" first,
                 anything else is "not an event file". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Share to Manotu" of an event file (ACTION_SEND with EXTRA_STREAM). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.manotu.event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
