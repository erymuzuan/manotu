# Build context: repository root (see deploy/docker-compose.yml)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/global.json backend/Directory.Build.props backend/Directory.Packages.props ./
COPY backend/src/Gimano.Core/Gimano.Core.csproj src/Gimano.Core/
COPY backend/src/Gimano.BackOffice/Gimano.BackOffice.csproj src/Gimano.BackOffice/
RUN dotnet restore src/Gimano.BackOffice/Gimano.BackOffice.csproj
COPY data/moderation/ /data/moderation/
COPY data/search/ /data/search/
COPY backend/src/Gimano.Core/ src/Gimano.Core/
COPY backend/src/Gimano.BackOffice/ src/Gimano.BackOffice/
# No --no-restore: the SDK adds Microsoft.AspNetCore.App.Internal.Assets (blazor.web.js) only when it sees .razor files,
# and the cached restore above ran before the sources were copied. Without it the page loads but nothing is interactive.
RUN dotnet publish src/Gimano.BackOffice/Gimano.BackOffice.csproj -c Release -o /app /p:UseAppHost=false
# Fail the build rather than ship a back office without its framework script.
RUN test -f /app/wwwroot/_framework/blazor.web.js

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .
ENV Urls=http://+:8080
EXPOSE 8080
RUN mkdir -p /data/keys && chown $APP_UID /data/keys
USER $APP_UID
ENTRYPOINT ["dotnet", "Gimano.BackOffice.dll"]
