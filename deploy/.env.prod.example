# Production env for deploy/docker-compose.prod.yml on 172.30.30.150.
# Copy to deploy/.env.prod (git-ignored; chmod 600), replace every CHANGE_ME. Never commit it.
# Generate secrets on the server:
#   openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48       (JWT, >= 32 chars)
#   openssl rand -base64 32 | tr -d '\n=+/'                    (passwords; no ; = + / so they're connection-string safe)

# Images (built by deploy/build-push.ps1 / build-push.sh)
REGISTRY=myhiro.azurecr.io
TAG=CHANGE_ME                 # git short sha printed by build-push (or 'latest')

# Secrets (local to .150)
JWT_SIGNING_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Shared RabbitMQ on 172.30.30.149 (vhost + user provisioned for Gimano; needs configure/write/read on the vhost)
RABBITMQ_HOST=172.30.30.149
RABBITMQ_PORT=5673
RABBITMQ_VHOST=gimano
RABBITMQ_USER=gimano
RABBITMQ_PASSWORD=CHANGE_ME

# Shared OpenSearch 3.0 on 172.30.30.149. The user's role needs: index permissions on "gimano-*"
# (create/delete index, aliases, read, write, get) + the cluster-level action "indices:data/write/bulk".
# No cluster:monitor is needed (readiness = HEAD on the prefixed alias).
OPENSEARCH_URL=https://172.30.30.149:9203
OPENSEARCH_USER=gimano
OPENSEARCH_PASSWORD=CHANGE_ME
OPENSEARCH_INDEX_PREFIX=gimano-
OPENSEARCH_REPLICAS=0          # single-node cluster: 0, or indices stay yellow
# The .149 cluster uses the OpenSearch demo certificate: skip validation for this connection only.
OPENSEARCH_ALLOW_INVALID_CERT=true

# Self-hosting without .149: run `--profile local-infra` and set RABBITMQ_HOST=rabbitmq, RABBITMQ_PORT=5672,
# OPENSEARCH_URL=https://opensearch:9200, OPENSEARCH_USER=admin, OPENSEARCH_PASSWORD=<strong: upper/lower/digit/special>.

# Networking: publish the API only on the LAN interface that IIS ARR (.13) reaches
API_BIND=172.30.30.150
API_PORT=5080
TRUSTED_PROXIES=172.30.30.13
PUBLIC_BASE_URL=https://gimano-api.bukitbunga.com
SHARE_VIEWER_ORIGINS=https://www.bukitbunga.com
RATE_LIMIT_PER_MINUTE=600

# Keep the deprecated /me/places* until the apps ship the on-device store, then set false (410 Gone)
LEGACY_SAVED_PLACES=true

# (No GitHub-issue sink for feedback in production: feedback text can contain personal details. Dev only.)

# Identity (docs/identity-and-reputation.md §2). Accounts with a key must ALWAYS sign. Key-less legacy accounts
# (0.1.0 apps) are accepted unsigned while ALLOW_LEGACY_UNSIGNED=true (capped at baharu, votes ≤ 1).
# REQUIRE_SIGNATURES=true is a kill switch: reject every unsigned contribution, legacy accounts included.
REQUIRE_SIGNATURES=false
ALLOW_LEGACY_UNSIGNED=true
ATTESTATION_MODE=log
# ATTESTATION_ANDROID_PACKAGE=my.gimano.app
# ATTESTATION_ANDROID_SA_JSON=     # service-account JSON (one line) with Play Integrity access; absent → "not configured"
# ATTESTATION_IOS_APP_ID=TEAMID.my.gimano.app

# Contact details volunteered on feedback/crash reports are encrypted with this AES-256 key (base64, 32 bytes).
# Losing it makes stored contacts unreadable (they expire within 90 days anyway). Generate: openssl rand -base64 32
FEEDBACK_CONTACT_KEY=CHANGE_ME
# Maintainer view /api/v1/admin/* (header X-Admin-Key, >= 24 chars); leave empty to disable. openssl rand -base64 36
ADMIN_KEY=
# Agent endpoints /admin/v1 and /mcp (docs/back-office.md). Off until the back office is deliberately deployed to prod;
# then set true and the CIDR agents connect from (Tailscale: 100.64.0.0/10). Cloudflare requests are always refused.
AGENT_ADMIN_ENABLED=false
AGENT_ADMIN_NETWORKS=127.0.0.1/32
# Back office (docs/back-office.md). Bind to 127.0.0.1 and reach it with `tailscale serve`/an SSH tunnel, or to an address
# only the VPN reaches. Never the address IIS ARR publishes. BACKOFFICE_MAINTAINERS = the emails allowed to register (comma-separated).
BACKOFFICE_BIND=127.0.0.1
BACKOFFICE_PORT=5090
BACKOFFICE_PUBLIC_URL=http://127.0.0.1:5090
BACKOFFICE_MAINTAINERS=
# The API address shown to agents on "Agent access" (claude mcp add …/mcp): the api as agents reach it.
BACKOFFICE_API_BASE_URL=http://172.30.30.150:5080
# Maintainer digest: counts-only email at 08:00 Malaysia time + moderation alerts (worker). Azure Communication Services
# connection string (the same ACS resource as HiRO's AzureCommunicationServiceConnectionString); empty = digest off.
DIGEST_ACS_CONNECTION_STRING=
DIGEST_FROM=DoNotReply@bukitbunga.com
DIGEST_TO=   # comma-separated
# Opaque per-author handles for "hide this contributor" (base64, 32 bytes). Optional: empty = derived from JWT_SIGNING_KEY,
# but set it so rotating the JWT key doesn't change every handle. openssl rand -base64 32
AUTHOR_HANDLE_KEY=
# Event short links (encrypted relay, /api/v1/drops): HMAC key for the uploader hash (base64, 32 bytes). Optional: empty =
# derived from JWT_SIGNING_KEY, but set it so rotating the JWT key keeps link owners. openssl rand -base64 32
DROPS_OWNER_KEY=
