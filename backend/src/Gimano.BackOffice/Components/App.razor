<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <base href="/" />
    <ResourcePreloader />
    @if (IsAccountPage)
    {
        @* The Identity pages come from the template and are styled with Bootstrap; the back office itself is not. *@
        <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    }
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Gimano.BackOffice.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["manotu-icon.svg"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" href="@Assets["logo.png"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool IsAccountPage => HttpContext.Request.Path.StartsWithSegments("/Account");
}
