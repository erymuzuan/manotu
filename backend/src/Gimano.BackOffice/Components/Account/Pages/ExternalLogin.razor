@page "/Account/ExternalLogin"
@using Gimano.BackOffice.Data
@inject GoogleMaintainerLogin GoogleLogin
@inject IdentityRedirectManager RedirectManager
<PageTitle>Sign in · Manotu</PageTitle>
<p>Completing sign-in…</p>
@code {
    public const string LoginCallbackAction = "LoginCallback";
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Action { get; set; }
    [SupplyParameterFromQuery] private string? RemoteError { get; set; }
    protected override async Task OnInitializedAsync()
    {
        if (!HttpMethods.IsGet(HttpContext.Request.Method) || Action != LoginCallbackAction || RemoteError is not null)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }
        var result = await GoogleLogin.SignInAsync();
        if (result.RequiresTwoFactor)
            RedirectManager.RedirectTo("Account/LoginWithEmailCode", new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = false });
        else if (result.Succeeded) RedirectManager.RedirectTo(ReturnUrl);
        else RedirectManager.RedirectToWithStatus("Account/Login", "Sign-in was not allowed. Use an approved moderator Google account.", HttpContext);
    }
}
