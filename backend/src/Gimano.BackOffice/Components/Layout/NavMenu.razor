@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="side" aria-label="Back office">
    <a class="brand" href="">
        <img src="manotu-icon.svg" width="40" height="40" alt="Manotu" />
        <span><strong>Manotu</strong><small>Back office</small></span>
    </a>
    <AuthorizeView>
        <Authorized>
            <NavLink class="side-link" href="" Match="NavLinkMatch.All">Inbox</NavLink>
            <NavLink class="side-link" href="crashes">Crash groups</NavLink>
            <NavLink class="side-link" href="feedback">Feedback</NavLink>
            <NavLink class="side-link" href="runs">Agent runs</NavLink>
            <NavLink class="side-link" href="replies">Replies outbox</NavLink>
            <NavLink class="side-link" href="builds">Releases</NavLink>
            <NavLink class="side-link" href="app-versions">App versions</NavLink>
            <NavLink class="side-link" href="agent-access">Agent access</NavLink>
            <NavLink class="side-link" href="brand-watchlist">Brand watchlist</NavLink>
            <NavLink class="side-link" href="audit">Audit log</NavLink>
            <div class="side-foot">
                <NavLink class="side-link small" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="side-link small">Sign out</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <NavLink class="side-link" href="Account/Login">Sign in</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
